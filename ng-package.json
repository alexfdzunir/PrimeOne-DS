{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist/prime-one-ds",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "input": "src/aem",
      "glob": "**/*.{css,js}",
      "output": "aem"
    },
    {
      "input": "src/aem",
      "glob": "aem.d.ts",
      "output": "aem"
    },
    {
      "input": "src/aem/assets",
      "glob": "**/*.{png,jpg,webp,svg}",
      "output": "aem/assets"
    }
  ]
}
