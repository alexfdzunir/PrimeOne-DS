{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@figma/code-connect/figma-types"]
  },
  "include": ["src/**/*.figma.ts", "src/figma/**/*.ts"]
}
